# Multi-stage build para aplicação React + Vite
FROM node:20-alpine AS build

WORKDIR /app

# Copia package.json e package-lock.json do frontend-react
COPY frontend-react/package*.json ./
RUN npm ci

# Copia todo o código-fonte do frontend-react e faz o build de produção
COPY frontend-react/ ./
RUN npm run build

# Estágio de Servidor Nginx
FROM nginx:alpine

# Copia os arquivos estáticos compilados para o diretório padrão do Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copia configuração customizada do Nginx (opcional/padrão)
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
